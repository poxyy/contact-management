{
    "openapi": "3.1.1",
    "info": {
        "title": "User API",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost"
        }
    ],
    "paths": {
        "/api/users": {
            "post": {
                "summary": "Register a new user",
                "description": "Registers a new user with the provided username, password, and name.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "username",
                                    "password",
                                    "name"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "minLength": 2
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 3
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                }
                            },
                            "examples": {
                                "john": {
                                    "description": "Example of registering user john",
                                    "value": {
                                        "username": "john",
                                        "password": "SecretPassword123!",
                                        "name": "John Doe"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User successfully registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "username": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "successRegistration": {
                                        "description": "Successful user registration response",
                                        "value": {
                                            "data": {
                                                "id": 1,
                                                "username": "john",
                                                "name": "John Doe"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error or invalid input",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "validationError": {
                                        "description": "Example of validation errors",
                                        "value": {
                                            "errors": {
                                                "username": [
                                                    "username must not be blank",
                                                    "username must be at least 2 characters"
                                                ],
                                                "password": [
                                                    "password must be at least 3 characters",
                                                    "password must contain at least one uppercase letter, one lowercase letter, one number, and one special character"
                                                ],
                                                "name": [
                                                    "name must not be blank"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict: Username already exists",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "usernameConflict": {
                                        "description": "Example of username conflict error",
                                        "value": {
                                            "errors": {
                                                "username": [
                                                    "username already exists"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "internalError": {
                                        "description": "Example of an internal server error",
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "An unexpected error occurred. Please try again later."
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/users/current": {
            "get": {
                "summary": "Get current user",
                "description": "Returns the authenticated user's profile based on the session cookie (Laravel Sanctum).",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved user profile",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "username": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - invalid or missing token",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "summary": "Update current user",
                "description": "Update the authenticated user's name and/or password.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "requestBody": {
                    "description": "Update current user",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 3
                                    }
                                }
                            },
                            "examples": {
                                "updateName": {
                                    "value": {
                                        "name": "John Updated"
                                    }
                                },
                                "updatePassword": {
                                    "value": {
                                        "password": "NewPassword123!"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully updated user profile",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "username": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "validationError": {
                                        "value": {
                                            "errors": {
                                                "name": [
                                                    "Name must not be blank"
                                                ],
                                                "password": [
                                                    "Password must be at least 3 characters"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - invalid or missing token",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/users/login": {
            "post": {
                "summary": "User login",
                "description": "Authenticates user and returns user profile with access token.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "minLength": 2
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 3
                                    }
                                }
                            },
                            "examples": {
                                "loginExample": {
                                    "value": {
                                        "username": "john",
                                        "password": "SecretPassword123!"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "username": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "token": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "successLogin": {
                                        "value": {
                                            "data": {
                                                "id": 1,
                                                "username": "john",
                                                "name": "John Doe",
                                                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid username or password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "properties": {
                                                "credentials": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "invalidCredentials": {
                                        "value": {
                                            "errors": {
                                                "credentials": [
                                                    "Invalid username or password"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "internalError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "An unexpected error occurred. Please try again later."
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/users/logout": {
            "delete": {
                "summary": "Logout current user",
                "description": "Logs out the currently authenticated user by invalidating the access token.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully logged out user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                },
                                "examples": {
                                    "successLogout": {
                                        "value": {
                                            "data": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - token missing or invalid",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "internalError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error occurred during logout."
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "XSRF-TOKEN"
            }
        }
    }
}