{
    "openapi": "3.1.1",
    "info": {
        "title": "Contact API",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost"
        }
    ],
    "paths": {
        "/api/contacts": {
            "post": {
                "summary": "Create new contact",
                "description": "Create a new contact with first name, last name, email, and phone.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "requestBody": {
                    "description": "Contact data to create",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "first_name"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "last_name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "phone": {
                                        "type": "string"
                                    }
                                }
                            },
                            "examples": {
                                "createContact": {
                                    "value": {
                                        "first_name": "Jane",
                                        "last_name": "Doe",
                                        "email": "jane.doe@example.com",
                                        "phone": "08123456789"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contact successfully created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "format": "email"
                                                },
                                                "phone": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "successCreate": {
                                        "value": {
                                            "data": {
                                                "id": 1001,
                                                "first_name": "Jane",
                                                "last_name": "Doe",
                                                "email": "jane.doe@example.com",
                                                "phone": "08123456789"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "validationError": {
                                        "value": {
                                            "errors": {
                                                "email": [
                                                    "Invalid email format"
                                                ],
                                                "first_name": [
                                                    "First name must not be blank"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - token missing or invalid",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "internalError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error while creating contact"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "summary": "Search contacts",
                "description": "Search and filter contacts by name, email, or phone. Supports pagination.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Bearer token (e.g. Bearer <access_token>)"
                    },
                    {
                        "name": "name",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search by contact name (partial match)"
                    },
                    {
                        "name": "phone",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search by phone number"
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "email"
                        },
                        "description": "Search by email address"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        },
                        "description": "Page number for pagination"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "minimum": 1,
                            "maximum": 100
                        },
                        "description": "Number of results per page"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved contacts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "first_name": {
                                                        "type": "string"
                                                    },
                                                    "last_name": {
                                                        "type": "string"
                                                    },
                                                    "email": {
                                                        "type": "string",
                                                        "format": "email"
                                                    },
                                                    "phone": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "page": {
                                                    "type": "integer"
                                                },
                                                "size": {
                                                    "type": "integer"
                                                },
                                                "total": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "example": {
                                        "value": {
                                            "data": [
                                                {
                                                    "id": 1,
                                                    "first_name": "Jane",
                                                    "last_name": "Doe",
                                                    "email": "jane.doe@example.com",
                                                    "phone": "08123456789"
                                                }
                                            ],
                                            "meta": {
                                                "page": 1,
                                                "size": 10,
                                                "total": 50
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - missing or invalid token",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "serverError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error while searching contacts"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/contacts/{id}": {
            "delete": {
                "summary": "Delete contact",
                "description": "Delete a contact by its ID.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Contact successfully deleted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                },
                                "examples": {
                                    "deleteSuccess": {
                                        "value": {
                                            "data": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - invalid or missing token",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Contact not found",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "notFound": {
                                        "value": {
                                            "errors": {
                                                "contact": [
                                                    "Contact with specified ID not found"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "serverError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error while deleting contact"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "summary": "Get contact by ID",
                "description": "Retrieve a specific contact by its unique ID.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved contact",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "format": "email"
                                                },
                                                "phone": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "success": {
                                        "value": {
                                            "data": {
                                                "id": 1001,
                                                "first_name": "Jane",
                                                "last_name": "Doe",
                                                "email": "jane.doe@example.com",
                                                "phone": "08123456789"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - token missing or invalid",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Contact not found",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "notFound": {
                                        "value": {
                                            "errors": {
                                                "contact": [
                                                    "Contact with specified ID not found"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "serverError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error while retrieving contact"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Update contact",
                "description": "Update a contact's information by ID.",
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "requestBody": {
                    "description": "Updated contact data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "first_name"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "last_name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "phone": {
                                        "type": "string"
                                    }
                                }
                            },
                            "examples": {
                                "updateContact": {
                                    "value": {
                                        "first_name": "Joe",
                                        "last_name": "Blow",
                                        "email": "joe.blow@example.com",
                                        "phone": "0899123456"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contact successfully updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "format": "email"
                                                },
                                                "phone": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "successUpdate": {
                                        "value": {
                                            "data": {
                                                "id": 1001,
                                                "first_name": "Joe",
                                                "last_name": "Blow",
                                                "email": "joe.blow@example.com",
                                                "phone": "0899123456"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "validationError": {
                                        "value": {
                                            "errors": {
                                                "email": [
                                                    "Invalid email format"
                                                ],
                                                "first_name": [
                                                    "First name must not be blank"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - token missing or invalid",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "unauthorized": {
                                        "value": {
                                            "errors": {
                                                "authorization": [
                                                    "Invalid or expired token"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Contact not found",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "notFound": {
                                        "value": {
                                            "errors": {
                                                "contact": [
                                                    "Contact with ID not found"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "serverError": {
                                        "value": {
                                            "errors": {
                                                "server": [
                                                    "Unexpected error while updating contact"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "XSRF-TOKEN"
            }
        }
    }
}